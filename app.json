{
  "expo": {
    "name": "Dork Bot",
    "slug": "dork-bot",
    "version": "0.10.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "dorkbot",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1012",
    "ios": {
      "bundleIdentifier": "com.brenw2.dorkbot",
      "appleTeamId": "C7Z2H37BVG",
      "buildNumber": "10",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSUserActivityTypes": [
          "INSendMessageIntent"
        ]
      },
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.brenw2.dorkbot"
        ],
        "com.apple.developer.usernotifications.communication": true
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-system-ui",
      [
        "expo-screen-orientation",
        {
          "initialOrientation": "PORTRAIT_UP"
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Dork Bot sends the pictures you pick to your bots.",
          "cameraPermission": "Dork Bot sends the photos you take to your bots.",
          "microphonePermission": false
        }
      ],
      "@bacons/apple-targets"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "e19b3c18-96ee-45f3-8f71-0c6d52950c21"
      }
    },
    "owner": "brenw2"
  }
}
